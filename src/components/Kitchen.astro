---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { featured, sections } from '../data/menu';
import { site, waLink, type Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).kitchen;
const askMsg = lang === 'es' ? 'Hola! ¿Qué hay hoy en la carta?' : 'Hi! What is on the menu today?';
---
<section id="cocina" class="bg-bg-alt py-20 sm:py-28" aria-labelledby="kitchen-title">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <p class="kicker">{s.kicker}</p>
      <h2 id="kitchen-title" class="section-title">{s.title}</h2>
      <p class="mt-5 text-lg text-ink-soft">{s.lead}</p>
    </div>

    <!-- Platos destacados (el primero va más ancho) -->
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {featured.map((d, i) => (
        <li class:list={['reveal card lift group overflow-hidden', i === 0 && 'sm:col-span-2']}>
          <article class="flex h-full flex-col">
            <div class="zoom relative overflow-hidden">
              <Image src={d.image} alt={d.alt[lang]} widths={i === 0 ? [480, 800, 1100] : [400, 640, 800]}
                sizes={i === 0 ? '(min-width: 1024px) 60vw, (min-width: 640px) 90vw, 100vw' : '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw'}
                class:list={['w-full object-cover', i === 0 ? 'aspect-[3/2] sm:aspect-[21/10]' : 'aspect-[3/2]']} />
              {d.tag && <span class="absolute left-3 top-3 rounded-full bg-wine px-3 py-1 text-xs font-bold text-white">{d.tag[lang]}</span>}
            </div>
            <div class="flex-1 p-5">
              <h3 class:list={['font-semibold', i === 0 ? 'text-2xl' : 'text-xl']}>{d.name[lang]}</h3>
              <p class="mt-1.5 text-ink-soft">{d.description[lang]}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <!-- Otros platos que solemos hacer -->
    <div class="reveal relative mt-16 rounded-[2rem] border-2 border-brand/25 bg-surface p-6 sm:p-10 lg:p-14">
      <div class="pointer-events-none absolute inset-3 rounded-[1.5rem] border border-brand/15" aria-hidden="true"></div>
      <div class="relative text-center">
        <p class="kicker justify-center">{site.name}</p>
        <h3 class="mt-2 text-3xl font-semibold sm:text-4xl">{s.fullMenu}</h3>
      </div>
      <div class="relative mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {sections.map((sec) => (
          <div>
            <h4 class="mb-4 border-b-2 border-brand pb-2 font-serif text-xl font-semibold text-brand">{sec.title[lang]}</h4>
            <ul class="space-y-3">
              {sec.items.map((it) => (
                <li>
                  <div class="flex items-end gap-2">
                    <span class="font-semibold">{it.name[lang]}</span>
                    <span class="menu-dots" aria-hidden="true"></span>
                    <span class="glyph text-brand" aria-hidden="true">✦</span>
                  </div>
                  {it.note && <p class="text-sm italic text-ink-soft">{it.note[lang]}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="relative mt-10 flex flex-col items-center gap-4 text-center">
        <p class="max-w-xl text-ink-soft">{s.fullMenuNote}</p>
        <a href={waLink(site.phones[0].whatsapp, askMsg)} target="_blank" rel="noopener" class="btn btn-outline">
          <Icon name="whatsapp" /> {s.ask}
        </a>
      </div>
    </div>
  </div>
</section>
