---
import { Image } from 'astro:assets';
import { featured } from '../data/menu';
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).kitchen;
---
<section id="cocina" class="bg-bg-alt py-20 sm:py-28" aria-labelledby="kitchen-title">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <p class="kicker">{s.kicker}</p>
      <h2 id="kitchen-title" class="section-title">{s.title}</h2>
      <p class="mt-5 text-lg text-ink-soft">{s.lead}</p>
    </div>

    <!-- Platos destacados (el primero va más ancho) -->
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {featured.map((d, i) => (
        <li class:list={['reveal card lift group overflow-hidden', i === 0 && 'sm:col-span-2']}>
          <article class="flex h-full flex-col">
            <div class="zoom relative overflow-hidden">
              <Image src={d.image} alt={d.alt[lang]} widths={i === 0 ? [480, 800, 1100] : [400, 640, 800]}
                sizes={i === 0 ? '(min-width: 1024px) 60vw, (min-width: 640px) 90vw, 100vw' : '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw'}
                class:list={['w-full object-cover', i === 0 ? 'aspect-[3/2] sm:aspect-[21/10]' : 'aspect-[3/2]']} />
              {d.tag && <span class="absolute left-3 top-3 rounded-full bg-wine px-3 py-1 text-xs font-bold text-white">{d.tag[lang]}</span>}
            </div>
            <div class="flex-1 p-5">
              <h3 class:list={['font-semibold', i === 0 ? 'text-2xl' : 'text-xl']}>{d.name[lang]}</h3>
              <p class="mt-1.5 text-ink-soft">{d.description[lang]}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
