---
import { getImage } from 'astro:assets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import heroDesktop from '../assets/images/hero-fachada-escritorio.jpg';
import heroMobile from '../assets/images/hero-fachada-celular.jpg';
import { site, waLink, type Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
const slogans = site.slogans[lang];
const alt = lang === 'es'
  ? 'Fachada roja del restaurante Lo de Juan y Cristina, con galería de arcos, rodeada de árboles y campo bajo un cielo azul'
  : 'Red façade of Lo de Juan y Cristina restaurant, with an arched porch, surrounded by trees and fields under a blue sky';

// Dirección de arte: recorte vertical en celular, apaisado en pantallas medianas y grandes
const Q = 80;
const desktopWidths = [960, 1280, 1600, 1920, 2560];
const mobileWidths = [480, 768, 960];
const [dAvif, dWebp, mAvif, mWebp, fallback] = await Promise.all([
  getImage({ src: heroDesktop, widths: desktopWidths, format: 'avif', quality: Q }),
  getImage({ src: heroDesktop, widths: desktopWidths, format: 'webp', quality: Q }),
  getImage({ src: heroMobile, widths: mobileWidths, format: 'avif', quality: Q }),
  getImage({ src: heroMobile, widths: mobileWidths, format: 'webp', quality: Q }),
  getImage({ src: heroDesktop, width: 1600, format: 'jpg', quality: Q }),
]);
const mq = '(max-width: 767px)';
---
<section id="inicio" class="on-dark relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-wine-deep text-white" aria-labelledby="hero-title">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <picture>
      <source media={mq} type="image/avif" srcset={mAvif.srcSet.attribute} sizes="100vw" />
      <source media={mq} type="image/webp" srcset={mWebp.srcSet.attribute} sizes="100vw" />
      <source type="image/avif" srcset={dAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={dWebp.srcSet.attribute} sizes="100vw" />
      <img
        src={fallback.src}
        alt={alt}
        width={heroDesktop.width}
        height={heroDesktop.height}
        loading="eager"
        decoding="async"
        class="kenburns h-full w-full object-cover object-[50%_35%] md:object-[62%_40%]"
      />
    </picture>
  </div>

  <!-- Legibilidad: oscurece solo donde está el texto, sin teñir la foto -->
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-28 bg-gradient-to-b from-black/45 to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/45 via-45% to-transparent to-75% md:bg-gradient-to-r md:from-black/70 md:via-black/35 md:via-40% md:to-transparent md:to-65%" aria-hidden="true"></div>

  <div class="container-x flex flex-1 flex-col justify-end pb-10 pt-28 md:justify-center md:pb-16">
    <div class="max-w-2xl">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-black/35 px-4 py-1.5 text-sm font-semibold backdrop-blur-sm">
        <Icon name="pin" class="size-4" /> {s.hero.eyebrow}
      </p>
      <h1 id="hero-title" class="drop-shadow-[0_2px_12px_rgb(0_0_0/0.5)]">
        <span class="sr-only">{site.name} — </span>
        <Logo size="lg" variant="white" />
      </h1>
      <p class="mt-6 font-serif text-xl italic text-cream drop-shadow-[0_1px_6px_rgb(0_0_0/0.6)] sm:text-2xl">{s.hero.tagline}</p>
      <p class="mt-3 max-w-lg text-lg text-white/95 drop-shadow-[0_1px_6px_rgb(0_0_0/0.6)]">{s.hero.lead}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={waLink(site.phones[0].whatsapp, s.contact.waMsg)} target="_blank" rel="noopener" class="btn btn-wa text-lg">
          <Icon name="whatsapp" class="size-6" /> {s.hero.whatsapp}
        </a>
        <a href={site.googleMaps.link} target="_blank" rel="noopener" class="btn btn-ghost bg-black/20 text-lg text-white backdrop-blur-sm">
          <Icon name="pin" /> {s.hero.directions}<span class="sr-only"> {s.newTab}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Cinta de lemas -->
  <div class="marquee relative border-t border-white/15 bg-wine/90 py-3 backdrop-blur" aria-label={slogans.join(' · ')} role="img">
    <div class="marquee-track flex w-max gap-10 whitespace-nowrap font-serif text-lg italic text-cream" aria-hidden="true">
      {[...slogans, ...slogans, ...slogans, ...slogans].map((x) => (
        <span class="flex items-center gap-10">{x}<span class="glyph text-white/50 not-italic">✦</span></span>
      ))}
    </div>
  </div>
</section>
