---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { cartaFaces, cartaText } from '../data/carta';
import type { Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).carta;
const { front, back } = cartaFaces;
// Versiones grandes para el visor con zoom
const [bigFront, bigBack] = await Promise.all([
  getImage({ src: front.image, width: 2000, format: 'webp', quality: 82 }),
  getImage({ src: back.image, width: 2000, format: 'webp', quality: 82 }),
]);
const faceWidths = [480, 720, 960, 1280];
const faceSizes = '(min-width: 1024px) 860px, 92vw';
---
<section id="carta" class="carta-section on-dark relative isolate overflow-hidden py-20 text-cream sm:py-28" aria-labelledby="carta-title">
  <div class="container-x">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="kicker justify-center !text-[#f3b6c4]">{s.kicker}</p>
      <h2 id="carta-title" class="mt-3 text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">{s.title}</h2>
      <p class="mt-5 text-lg text-cream/90">{s.lead}</p>
    </div>

    <div class="reveal mx-auto mt-12 max-w-[54rem]" data-carta-root>
      <div
        class="carta-stage"
        data-carta-stage
        tabindex="0"
        role="group"
        aria-roledescription={lang === 'es' ? 'carta giratoria' : 'turnable menu'}
        aria-label={s.stage}
      >
        <div class="carta-3d" data-carta-card>
          <div class="carta-face carta-front">
            <Image src={front.image} alt={front.alt[lang]} widths={faceWidths} sizes={faceSizes} loading="lazy" draggable="false" class="h-full w-full object-cover" />
          </div>
          <div class="carta-face carta-back">
            <Image src={back.image} alt={back.alt[lang]} widths={faceWidths} sizes={faceSizes} loading="lazy" draggable="false" class="h-full w-full object-cover" />
          </div>
          <span class="carta-edge carta-edge-l" aria-hidden="true"></span>
          <span class="carta-edge carta-edge-r" aria-hidden="true"></span>
        </div>
        <div class="carta-floor" aria-hidden="true"></div>
      </div>

      <p class="mt-6 flex items-center justify-center gap-2 text-sm text-cream/80" aria-hidden="true">
        <Icon name="rotate" class="size-4" /> {s.hint}
      </p>
      <div class="mt-4 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button type="button" class="btn bg-cream text-wine" data-carta-flip>
          <Icon name="rotate" /> {s.flip}
        </button>
        <button type="button" class="btn btn-ghost text-cream" data-carta-zoom>
          <Icon name="expand" /> {s.zoom}
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-carta-live data-tpl={s.showing} data-front={front.label[lang]} data-back={back.label[lang]}></p>

      <!-- Carta en texto (accesibilidad y buscadores) -->
      <details class="carta-text mt-10 rounded-3xl bg-cream text-[#2b1a1e]">
        <summary class="tap flex cursor-pointer list-none items-center justify-between gap-4 rounded-3xl px-6 py-5 font-serif text-xl font-semibold">
          {s.textToggle}
          <span class="carta-chevron grid size-9 place-items-center rounded-full bg-wine text-white" aria-hidden="true"><Icon name="down" class="size-4" /></span>
        </summary>
        <div class="grid gap-x-12 gap-y-8 px-6 pb-8 pt-2 md:grid-cols-2" lang="es">
          {cartaText.map((sec) => (
            <div>
              <h3 class="mb-3 border-b-2 border-[#8a2846] pb-1.5 font-serif text-lg font-semibold text-[#8a2846]">{sec.title}</h3>
              {sec.items && (
                <ul class="space-y-2">
                  {sec.items.map((it) => (
                    <li class="flex items-end gap-2">
                      <span>{it.name}</span>
                      <span class="mb-1.5 flex-1 border-b-2 border-dotted border-[#e4d5c2]" aria-hidden="true"></span>
                      {it.price && <span class="shrink-0 font-semibold tabular-nums">{it.price}</span>}
                    </li>
                  ))}
                </ul>
              )}
              {sec.text && <p class="text-[#5c4a4e]">{sec.text}</p>}
            </div>
          ))}
          <p class="text-sm italic text-[#5c4a4e] md:col-span-2" lang={lang}>{s.pricesNote}</p>
        </div>
      </details>
    </div>
  </div>

  <!-- Visor a pantalla completa con zoom -->
  <dialog class="carta-viewer m-0 h-full max-h-none w-full max-w-none bg-[#1a0d12] p-0 text-white on-dark" aria-label={s.viewer} data-carta-viewer>
    <div class="flex h-full flex-col">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 px-3 py-2 sm:px-5">
        <div class="flex rounded-full bg-white/10 p-1" role="group" aria-label={lang === 'es' ? 'Lado de la carta' : 'Menu side'}>
          <button type="button" class="cv-side" data-cv-side="front" aria-pressed="true">{front.label[lang]}</button>
          <button type="button" class="cv-side" data-cv-side="back" aria-pressed="false">{back.label[lang]}</button>
        </div>
        <div class="flex items-center gap-1">
          <button type="button" class="cv-btn tap" data-cv-out aria-label={s.zoomOut}><Icon name="zoom-out" /></button>
          <span class="w-12 text-center text-sm font-bold tabular-nums" data-cv-level aria-live="polite">100%</span>
          <button type="button" class="cv-btn tap" data-cv-in aria-label={s.zoomIn}><Icon name="zoom-in" /></button>
          <button type="button" class="cv-btn tap ml-2" data-cv-close aria-label={s.close}><Icon name="close" class="size-6" /></button>
        </div>
      </div>
      <div class="cv-scroll flex-1 overflow-auto" data-cv-scroll>
        <img data-cv-img alt="" class="cv-img" data-front-src={bigFront.src} data-back-src={bigBack.src}
          data-front-alt={front.alt[lang]} data-back-alt={back.alt[lang]} width="2000" height="1414" />
      </div>
    </div>
  </dialog>
</section>

<style>
  @layer components {
    /* Mantel bordó de fondo, como en las fotos de la carta */
    .carta-section {
      background-color: #6e1d37;
      background-image:
        repeating-linear-gradient(0deg, rgb(255 255 255 / .025) 0 1px, transparent 1px 4px),
        repeating-linear-gradient(90deg, rgb(0 0 0 / .05) 0 1px, transparent 1px 4px),
        radial-gradient(ellipse at 50% 30%, #8a2846 0%, #5a1830 70%);
    }

    .carta-stage {
      position: relative; perspective: 2200px; perspective-origin: 50% 40%;
      touch-action: pan-y;            /* no bloquea el scroll vertical de la página */
      cursor: grab; user-select: none; -webkit-user-select: none;
      border-radius: 1rem;
    }
    .carta-stage.is-dragging { cursor: grabbing; }
    .carta-stage:focus-visible { outline: 3px solid #ffd7a8; outline-offset: 8px; }

    .carta-3d {
      --ry: 0deg; --rx: 0deg;
      position: relative; aspect-ratio: 2000 / 1414;
      transform-style: preserve-3d;
      transform: rotateX(var(--rx)) rotateY(var(--ry));
      transition: transform .8s cubic-bezier(.2, .8, .2, 1);
      will-change: transform;
    }
    .carta-3d.no-anim { transition: transform .08s linear; }

    .carta-face {
      position: absolute; inset: 0; overflow: hidden; border-radius: 4px;
      backface-visibility: hidden; -webkit-backface-visibility: hidden;
      background: #f4ede2;
      box-shadow: inset 0 0 0 1px rgb(0 0 0 / .08), inset 0 0 40px rgb(120 80 40 / .12);
    }
    .carta-front { transform: translateZ(3px); }
    .carta-back { transform: rotateY(180deg) translateZ(3px); }
    /* Brillo suave del papel */
    .carta-face::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(115deg, rgb(255 255 255 / .18), transparent 40%, rgb(0 0 0 / .06));
    }

    /* Grosor del papel: cantos izquierdo y derecho */
    .carta-edge { position: absolute; top: 0; bottom: 0; width: 6px; background: linear-gradient(90deg, #d9cfbf, #efe7da, #d9cfbf); }
    .carta-edge-l { left: -3px; transform: rotateY(-90deg); }
    .carta-edge-r { right: -3px; transform: rotateY(90deg); }

    /* Sombra en la mesa */
    .carta-floor {
      position: absolute; left: 6%; right: 6%; bottom: -26px; height: 40px; z-index: -1;
      background: radial-gradient(ellipse at center, rgb(0 0 0 / .55), transparent 70%);
      filter: blur(6px); transform: scaleX(var(--floor, 1)); transition: transform .8s cubic-bezier(.2,.8,.2,1);
    }

    .carta-text summary::-webkit-details-marker { display: none; }
    .carta-chevron { transition: transform .3s ease; }
    .carta-text[open] .carta-chevron { transform: rotate(180deg); }

    /* Visor */
    dialog.carta-viewer::backdrop { background: rgb(10 4 6 / .9); }
    .cv-btn { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 999px; background: rgb(255 255 255 / .1); }
    @media (hover: hover) { .cv-btn:hover { background: rgb(255 255 255 / .2); } }
    .cv-side { min-height: 2.5rem; padding: 0 1rem; border-radius: 999px; font-weight: 700; font-size: .9rem; color: rgb(255 255 255 / .75); transition: background-color .2s, color .2s; }
    .cv-side[aria-pressed='true'] { background: #fbf5ec; color: #6e1d37; }
    .cv-scroll { touch-action: pan-x pan-y pinch-zoom; }
    .cv-img { display: block; width: calc(var(--z, 1) * 100%); max-width: none; height: auto; margin: auto; cursor: zoom-in; }
    .cv-scroll.is-zoomed .cv-img { cursor: zoom-out; }

    /* Movimiento reducido: el cambio de lado es un fundido, sin giro */
    @media (prefers-reduced-motion: reduce) {
      .carta-3d { transform: none !important; transition: none; }
      .carta-face, .carta-back, .carta-front { transform: none; backface-visibility: visible; transition: opacity .35s ease; }
      .carta-back { opacity: 0; }
      .carta-3d.is-back .carta-front { opacity: 0; }
      .carta-3d.is-back .carta-back { opacity: 1; }
      .carta-edge { display: none; }
      .carta-floor { transition: none; }
      .carta-chevron { transition: none; }
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-carta-root]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-carta-stage]')!;
    const card = root.querySelector<HTMLElement>('[data-carta-card]')!;
    const floor = root.querySelector<HTMLElement>('.carta-floor')!;
    const live = root.querySelector<HTMLElement>('[data-carta-live]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    let angle = 0;          // giro acumulado (múltiplos de 180 = un lado)
    let tiltX = 0, tiltY = 0;
    const isBack = () => (((Math.round(angle / 180) % 2) + 2) % 2) === 1;

    const render = () => {
      card.style.setProperty('--ry', `${angle + tiltY}deg`);
      card.style.setProperty('--rx', `${tiltX}deg`);
      // la sombra se achica cuando la carta está de canto
      floor.style.setProperty('--floor', String(0.35 + 0.65 * Math.abs(Math.cos(((angle + tiltY) * Math.PI) / 180))));
    };
    const announce = () => {
      card.classList.toggle('is-back', isBack());
      live.textContent = (live.dataset.tpl || '').replace('{side}', isBack() ? live.dataset.back! : live.dataset.front!);
    };
    const flip = () => { angle = Math.round(angle / 180) * 180 + 180; tiltX = tiltY = 0; render(); announce(); };
    const settle = () => { angle = Math.round(angle / 180) * 180; render(); announce(); };

    root.querySelector('[data-carta-flip]')!.addEventListener('click', flip);

    // ── Arrastre con Pointer Events (mouse y touch iguales) ──
    let down = false, startX = 0, startY = 0, startAngle = 0, startT = 0, moved = false;
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      down = true; moved = false; startX = e.clientX; startY = e.clientY; startAngle = angle; startT = performance.now();
      tiltX = tiltY = 0;
    });
    stage.addEventListener('pointermove', (e) => {
      if (down && !reduce.matches) {
        const dx = e.clientX - startX;
        if (!moved && Math.abs(dx) > 6 && Math.abs(dx) > Math.abs(e.clientY - startY)) {
          moved = true; stage.setPointerCapture(e.pointerId);
          stage.classList.add('is-dragging'); card.classList.add('no-anim');
        }
        if (moved) { angle = startAngle + (dx / stage.clientWidth) * 200; render(); }
        return;
      }
      // Inclinación leve al pasar el mouse por encima
      if (!down && e.pointerType === 'mouse' && !reduce.matches) {
        const r = stage.getBoundingClientRect();
        tiltY = ((e.clientX - r.left) / r.width - 0.5) * 10;
        tiltX = -((e.clientY - r.top) / r.height - 0.5) * 7;
        render();
      }
    });
    const release = (e: PointerEvent, cancelled = false) => {
      if (!down) return;
      down = false;
      stage.classList.remove('is-dragging'); card.classList.remove('no-anim');
      if (moved) { settle(); return; }
      // Toque o click corto: dar vuelta
      if (!cancelled && performance.now() - startT < 450 && Math.hypot(e.clientX - startX, e.clientY - startY) < 8) flip();
    };
    stage.addEventListener('pointerup', (e) => release(e));
    stage.addEventListener('pointercancel', (e) => release(e, true));
    stage.addEventListener('pointerleave', (e) => {
      if (down && !moved) down = false;
      if (e.pointerType === 'mouse' && !down) { tiltX = tiltY = 0; render(); }
    });
    stage.addEventListener('dragstart', (e) => e.preventDefault());

    // Teclado: Enter, Espacio o flechas para dar vuelta
    stage.addEventListener('keydown', (e) => {
      if (['Enter', ' ', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
        e.preventDefault();
        if (e.key === 'ArrowLeft') { angle = Math.round(angle / 180) * 180 - 180; tiltX = tiltY = 0; render(); announce(); }
        else flip();
      }
    });
    render();

    // ── Visor con zoom ──
    const dlg = document.querySelector<HTMLDialogElement>('[data-carta-viewer]')!;
    const img = dlg.querySelector<HTMLImageElement>('[data-cv-img]')!;
    const scroller = dlg.querySelector<HTMLElement>('[data-cv-scroll]')!;
    const level = dlg.querySelector<HTMLElement>('[data-cv-level]')!;
    const sides = [...dlg.querySelectorAll<HTMLButtonElement>('[data-cv-side]')];
    const zooms = [1, 1.5, 2, 3];
    let z = 0;
    const setZoom = (i: number, cx = 0.5, cy = 0.5) => {
      z = Math.max(0, Math.min(zooms.length - 1, i));
      img.style.setProperty('--z', String(zooms[z]));
      level.textContent = `${Math.round(zooms[z] * 100)}%`;
      scroller.classList.toggle('is-zoomed', z > 0);
      requestAnimationFrame(() => {
        scroller.scrollLeft = cx * scroller.scrollWidth - scroller.clientWidth / 2;
        scroller.scrollTop = cy * scroller.scrollHeight - scroller.clientHeight / 2;
      });
    };
    const showSide = (side: 'front' | 'back') => {
      img.src = img.dataset[side === 'front' ? 'frontSrc' : 'backSrc']!;
      img.alt = img.dataset[side === 'front' ? 'frontAlt' : 'backAlt']!;
      sides.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cvSide === side)));
    };
    let opener: HTMLElement | null = null;
    root.querySelector('[data-carta-zoom]')!.addEventListener('click', (e) => {
      opener = e.currentTarget as HTMLElement;
      showSide(isBack() ? 'back' : 'front');
      setZoom(0);
      dlg.showModal();
    });
    sides.forEach((b) => b.addEventListener('click', () => showSide(b.dataset.cvSide as 'front' | 'back')));
    dlg.querySelector('[data-cv-in]')!.addEventListener('click', () => setZoom(z + 1));
    dlg.querySelector('[data-cv-out]')!.addEventListener('click', () => setZoom(z - 1));
    dlg.querySelector('[data-cv-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => opener?.focus());
    // Click o doble toque en la imagen: acerca en ese punto / vuelve al tamaño normal
    img.addEventListener('click', (e) => {
      const r = img.getBoundingClientRect();
      if (z === 0) setZoom(2, (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
      else setZoom(0);
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === '+' || e.key === '=') setZoom(z + 1);
      if (e.key === '-') setZoom(z - 1);
    });
  }
</script>
