---
import Icon from './Icon.astro';
import PastaIcon from './PastaIcon.astro';
import { site, waLink, isPlaceholder, type Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).delivery;
const nt = t(lang).newTab;
const d = site.delivery;
const msg = d.waMessage[lang];
// Mientras un dato siga entre corchetes, se muestra "Lo coordinamos por WhatsApp"
const show = (v: { es: string; en: string }) => (isPlaceholder(v[lang]) ? null : v[lang]);
const rows = [
  { icon: 'map', label: s.zones, value: show(d.zones) },
  { icon: 'clock', label: s.schedule, value: show(d.schedule) },
  { icon: 'truck', label: s.minimum, value: show(d.minimum) },
] as const;
---
<section id="a-domicilio" class="pb-20 sm:pb-28" aria-labelledby="delivery-title">
  <div class="container-x">
    <div class="reveal on-dark relative isolate overflow-hidden rounded-[2rem] bg-wine-deep text-cream">
      <!-- decoración: pastas de fondo -->
      <div class="pointer-events-none absolute -right-10 -top-10 -z-10 text-white/[0.06]" aria-hidden="true">
        <PastaIcon type="raviolon" class="size-72 rotate-12" />
      </div>
      <div class="pointer-events-none absolute -bottom-16 left-1/3 -z-10 text-white/[0.05]" aria-hidden="true">
        <PastaIcon type="sorrentino" class="size-64" />
      </div>

      <div class="grid gap-10 p-7 sm:p-10 lg:grid-cols-[1.1fr_1fr] lg:p-14">
        <div>
          <p class="kicker !text-[#f3b6c4]">{s.kicker}</p>
          <h2 id="delivery-title" class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{s.title}</h2>
          <p class="mt-4 max-w-lg text-lg text-cream/90">{s.lead}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={waLink(site.phones[0].whatsapp, msg)} target="_blank" rel="noopener" class="btn btn-wa text-lg">
              <Icon name="whatsapp" class="size-6" /> {s.cta}<span class="sr-only"> {nt}</span>
            </a>
            <a href={waLink(site.phones[1].whatsapp, msg)} target="_blank" rel="noopener" class="tap text-sm font-semibold text-cream underline underline-offset-4">
              {s.or} {site.phones[1].display}<span class="sr-only"> {nt}</span>
            </a>
          </div>
        </div>

        <ul class="grid content-center gap-3" role="list">
          {rows.map((r) => (
            <li class="flex items-start gap-4 rounded-2xl bg-white/[0.07] p-4 ring-1 ring-white/10">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-cream text-wine"><Icon name={r.icon} /></span>
              <div>
                <p class="text-sm font-bold uppercase tracking-wider text-cream/70">{r.label}</p>
                <p class="mt-0.5 text-lg font-semibold text-white">{r.value ?? s.fallback}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
