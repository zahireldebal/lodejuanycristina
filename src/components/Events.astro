---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import panVino from '../assets/images/pan-escabeche-vino.jpg';
import { site, waLink, type Lang } from '../config/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang).events;
const first = s.excuses[0];
const imgAlt = lang === 'es'
  ? 'Mesa preparada con mantel bordó, pan casero, escabeche y copas de vino tinto'
  : 'Table set with a burgundy cloth, homemade bread, escabeche and glasses of red wine';
---
<section id="eventos" class="on-dark relative isolate overflow-hidden bg-wine-deep py-20 text-cream sm:py-28" aria-labelledby="events-title">
  <div class="pointer-events-none absolute -right-40 -top-40 -z-10 size-[30rem] rounded-full bg-wine blur-3xl" aria-hidden="true"></div>
  <div class="container-x grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div class="reveal">
      <p class="kicker !text-[#f3b6c4]">{s.kicker}</p>
      <h2 id="events-title" class="mt-3 text-4xl font-semibold text-white sm:text-5xl">{s.title}</h2>
      <p class="mt-5 text-lg text-cream/90">{s.lead}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {s.groups.map((g) => <li class="rounded-full border border-white/25 px-3 py-1 text-sm">{g}</li>)}
      </ul>

      <!-- Selector de excusa → mensaje de WhatsApp -->
      <form class="mt-10 rounded-3xl bg-white/[0.07] p-5 ring-1 ring-white/15 sm:p-7" data-excuse-form onsubmit="return false">
        <fieldset>
          <legend class="font-serif text-2xl font-semibold text-white">{s.pick}</legend>
          <p class="mt-1 text-sm text-cream/80">{s.pickHint}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {s.excuses.map((e, i) => (
              <label class="excuse-chip">
                <input type="radio" name="excuse" value={e.id} data-msg={e.msg} checked={i === 0} class="peer sr-only" />
                <span>{e.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="mt-5 rounded-2xl bg-black/25 p-4 text-sm italic text-cream/90" data-excuse-preview aria-live="polite">“{first.msg}”</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={waLink(site.phones[0].whatsapp, first.msg)} target="_blank" rel="noopener" class="btn btn-wa" data-excuse-link>
            <Icon name="whatsapp" class="size-6" /> {s.send}
          </a>
          <a href={waLink(site.phones[1].whatsapp, first.msg)} target="_blank" rel="noopener" class="tap text-sm font-semibold text-cream underline underline-offset-4" data-excuse-link-2>
            {lang === 'es' ? 'o al' : 'or'} {site.phones[1].display}
          </a>
        </div>
      </form>
    </div>

    <div class="reveal space-y-6">
      <Image src={panVino} alt={imgAlt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 38vw, 90vw"
        class="arch mx-auto aspect-[4/5] w-full max-w-sm object-cover shadow-2xl lg:max-w-none" />
      <aside class="flex gap-4 rounded-3xl bg-cream p-5 text-[#2b1a1e]">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-wine text-white"><Icon name="star" /></span>
        <div>
          <h3 class="font-serif text-lg font-semibold">{s.chivitoTitle}</h3>
          <p class="mt-1 text-sm text-[#5c4a4e]">{s.chivitoText}</p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  @layer components {
  .excuse-chip span {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: .5rem 1rem;
    border-radius: 999px; border: 1.5px solid rgb(255 255 255 / .35); font-weight: 700; font-size: .95rem;
    cursor: pointer; transition: background-color .25s ease, color .25s ease, border-color .25s ease, transform .2s ease;
  }
  @media (hover: hover) { .excuse-chip span:hover { border-color: #fff; transform: translateY(-1px); } }
  .excuse-chip span:active { transform: scale(.96); }
  .excuse-chip input:checked + span { background: #fbf5ec; color: #6e1d37; border-color: #fbf5ec; }
  .excuse-chip input:focus-visible + span { outline: 3px solid #ffd7a8; outline-offset: 3px; }
  }
</style>

<script>
  const form = document.querySelector('[data-excuse-form]');
  if (form) {
    const link = form.querySelector<HTMLAnchorElement>('[data-excuse-link]')!;
    const link2 = form.querySelector<HTMLAnchorElement>('[data-excuse-link-2]')!;
    const preview = form.querySelector('[data-excuse-preview]')!;
    form.addEventListener('change', (e) => {
      const msg = (e.target as HTMLInputElement).dataset.msg;
      if (!msg) return;
      const q = '?text=' + encodeURIComponent(msg);
      link.href = link.href.split('?')[0] + q;
      link2.href = link2.href.split('?')[0] + q;
      preview.textContent = `“${msg}”`;
    });
  }
</script>
